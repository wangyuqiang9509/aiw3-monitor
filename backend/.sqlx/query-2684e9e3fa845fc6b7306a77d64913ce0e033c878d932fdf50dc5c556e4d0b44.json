  "db_name": "PostgreSQL",
  "query": "\n            SELECT id, node_id, metric_type as \"metric_type: MetricType\", \n                   metric_value, collected_at, metadata\n            FROM metric_data\n            WHERE node_id = $1 \n              AND metric_type = $2\n              AND collected_at BETWEEN $3 AND $4\n            ORDER BY collected_at ASC\n            ",
