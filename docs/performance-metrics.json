  "monitoring_endpoints": {
    "rest_api": {
      "base_url": "http://localhost:1317",
      "endpoints": {
        "node_info": {
          "path": "/cosmos/base/tendermint/v1beta1/node_info",
          "method": "GET",
          "response_time_ms": 50
        },
        "sync_status": {
          "path": "/cosmos/base/tendermint/v1beta1/syncing",
          "method": "GET",
          "response_time_ms": 30
        },
        "latest_block": {
          "path": "/cosmos/base/tendermint/v1beta1/blocks/latest",
          "method": "GET",
          "response_time_ms": 60
        },
        "validators": {
          "path": "/cosmos/base/tendermint/v1beta1/validatorsets/latest",
          "method": "GET",
          "response_time_ms": 80
        }
      }
    },
    "rpc": {
      "base_url": "http://localhost:26657",
      "endpoints": {
        "status": {
          "path": "/status",
          "method": "GET",
          "response_time_ms": 40,
          "key_fields": [
            "result.sync_info.latest_block_height",
            "result.sync_info.latest_block_time",
            "result.sync_info.catching_up",
            "result.validator_info.voting_power"
          ]
        },
        "net_info": {
          "path": "/net_info",
          "method": "GET",
          "response_time_ms": 45,
          "key_fields": [
            "result.n_peers",
            "result.listening",
            "result.peers"
          ]
        },
        "abci_info": {
          "path": "/abci_info",
          "method": "GET",
          "response_time_ms": 35,
          "key_fields": [
            "result.response.last_block_height",
            "result.response.last_block_app_hash"
          ]
        }
      }
    },
    "health_checks": {
      "validator_health": {
        "endpoint": "http://localhost:26657/status",
        "interval_seconds": 30,
        "timeout_seconds": 10,
        "retries": 5,
        "expected_response": "catching_up: false"
      },
      "api_health": {
        "endpoint": "http://localhost:1317/cosmos/base/tendermint/v1beta1/node_info",
        "interval_seconds": 30,
        "timeout_seconds": 10,
        "expected_status_code": 200
      }
    }
  },

